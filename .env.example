ACTIVE_CLIENT_ID=auva
PIXIE_BACKEND_TARGET=recommender

# Base URL the UI uses to reach the proxy (same-origin gateway uses /api)
# API_BASE_URL=/api

# Allowed browser origins for the proxy (comma-separated or *)
# CORS_ALLOW_ORIGINS=http://localhost:3000

# Optional API key for secured Pixie Core requests
# PIXIE_API_KEY=

# Abuse guards (chat-proxy)
# MAX_CHAT_INPUT_CHARS=600
# MAX_CHAT_STATE_BYTES=16000
# MAX_CHAT_HISTORY_ITEMS=12
# MAX_CHAT_HISTORY_ENTRY_CHARS=320
# RATE_LIMIT_PER_MINUTE=24
# RATE_LIMIT_PER_HOUR=240
# RATE_LIMIT_BLOCK_SECONDS=300
# SESSION_IDLE_TIMEOUT_SECONDS=900

# Backend base URLs (defaults are used if unset)
# PIXIE_CORE_API_BASE_URL=http://recommender-api:8000
# PIXIE_INFORMER_API_BASE_URL=http://informer-api:8000
# PIXIE_QUESTIONER_API_BASE_URL=http://questioner-api:8000

# Questioner chat contract pin (validated by chat-proxy when target=questioner)
# PIXIE_CHAT_CONTRACT_VERSION=chat-v1.1.0
# STRICT_QUESTIONER_CHAT_CONTRACT=true

# Optional overrides for the active client
# ACTIVE_CLIENT_DISPLAY_NAME=
# ACTIVE_CLIENT_WELCOME_MESSAGE=
# ACTIVE_CLIENT_PRIMARY_COLOR=
# ACTIVE_CLIENT_LOGO_URL=
# ACTIVE_CLIENT_CHAT_HEADER_TITLE=
# ACTIVE_CLIENT_CHAT_HEADER_LOGO_URL=
# ACTIVE_CLIENT_LOGO_NO_TEXT_URL=
# ACTIVE_CLIENT_BACKGROUND_IMAGE_URL=
# ACTIVE_CLIENT_ALLOWED_LOCATIONS=Antwerpen|Gent|Hasselt
# ACTIVE_CLIENT_DEBUG_TOGGLE_ENABLED=false
# ACTIVE_CLIENT_DEBUG_DEFAULT_ENABLED=false

# Optional landing page copy and preset choices
# LANDING_TITLE=Welkom bij onze AI-assistent
# LANDING_RESEARCH_NOTE=Deze AI-assistent maakt deel uit van een TETRA-onderzoeksproject...
# LANDING_PRIVACY_NOTE=We vragen of bewaren geen persoonsgegevens...
# LANDING_START_LABEL=Start assistent
# LANDING_PRESETS=Man|Vrouw|Rode wijn=Rood|Witte wijn=Wit
